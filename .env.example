# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Prisma / PostgreSQL 18
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymmie
# Optional direct URL for Prisma CLI when DATABASE_URL uses a pooler.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/gymmie

# Google OAuth callback: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth does not support localhost/non-HTTPS callback URLs.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
