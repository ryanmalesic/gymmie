generator client {
  output   = "../lib/generated/prisma"
  provider = "prisma-client"
}

generator zod {
  provider                         = "zod-prisma-types"
  output                           = "../lib/generated/zod"
  prismaClientPath                 = "../../prisma"
  useMultipleFiles                 = true
  createInputTypes                 = true
  createModelTypes                 = true
  createOptionalDefaultValuesTypes = true
  createRelationValuesTypes        = false
  createPartialTypes               = true
  useDefaultValidators             = true
  validateWhereUniqueInput         = true
  coerceDate                       = true
  writeNullishInModelTypes         = false
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(dbgenerated("id()"))
  /// @zod.string.trim().min(1, { message: "Name is required" }).max(80, { message: "Name is too long" })
  name                String
  /// @zod.import(["import { Email } from '@/lib/zod'"]).custom.use(Email)
  email               String
  emailVerified       Boolean              @default(false)
  /// @zod.import(["import { HttpsUrl } from '@/lib/zod'"]).custom.use(HttpsUrl)
  image               String?
  /// @zod.import(["import { UsPhone } from '@/lib/zod'"]).custom.use(UsPhone)
  phone               String?
  /// @zod.string.trim().min(1, { message: "Address is required" }).max(255)
  addressLine1        String?
  /// @zod.string.trim().max(255)
  addressLine2        String?
  /// @zod.string.trim().min(1, { message: "City is required" }).max(100)
  city                String?
  /// @zod.import(["import { UsState } from '@/lib/zod'"]).custom.use(UsState)
  state               String?
  /// @zod.import(["import { UsPostalCode } from '@/lib/zod'"]).custom.use(UsPostalCode)
  postalCode          String?
  /// @zod.import(["import { IsoCountry } from '@/lib/zod'"]).custom.use(IsoCountry)
  country             String?              @default("US")
  /// @zod.import(["import { IanaTimezone } from '@/lib/zod'"]).custom.use(IanaTimezone)
  timezone            String?              @default("America/New_York")
  /// @zod.import(["import { Latitude } from '@/lib/zod'"]).custom.use(Latitude)
  latitude            Float?
  /// @zod.import(["import { Longitude } from '@/lib/zod'"]).custom.use(Longitude)
  longitude           Float?
  stripeAccountId     String?
  stripeAccountStatus StripeAccountStatus?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  accounts            Account[]
  ownedLocations      Location[]

  @@unique([email])
  @@index([stripeAccountId])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("id()"))
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("id()"))
  userId                String
  accountId             String
  providerId            String
  issuer                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("id()"))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

enum StripeAccountStatus {
  ACTIVATED
  DISABLED
  PENDING
  RESTRICTED
}

enum LocationStatus {
  ACTIVE
  CLOSED
  DRAFT
  ONBOARDING
  PAUSED
  PENDING
  REJECTED
  RESTRICTED
  SUSPENDED
}

enum LocationType {
  AQUATIC_CENTER
  BARRE_STUDIO
  BOUTIQUE_GYM
  BOXING_GYM
  CENTER
  CLIMBING_GYM
  COMBAT_GYM
  COMMERCIAL_GYM
  COMMUNITY_CENTER
  CROSSFIT_STUDIO
  GYM
  HOME_GYM
  HOTEL_GYM
  OTHER
  PILATES_STUDIO
  REHAB_CENTER
  SPIN_STUDIO
  STUDIO
  TRAINING_STUDIO
  UNIVERSITY_GYM
  YOGA_STUDIO
}

model Location {
  id           String         @id @default(dbgenerated("id()"))
  /// @zod.string.trim().min(1, { message: "Name is required" }).max(100, { message: "Name is too long" })
  name         String
  status       LocationStatus @default(DRAFT)
  type         LocationType
  /// @zod.import(["import { UsPhone } from '@/lib/zod'"]).custom.use(UsPhone)
  phone        String
  /// @zod.import(["import { Email } from '@/lib/zod'"]).custom.use(Email)
  email        String
  /// @zod.import(["import { HttpsUrl } from '@/lib/zod'"]).custom.use(HttpsUrl)
  website      String
  /// @zod.string.trim().min(1, { message: "Address is required" }).max(255)
  addressLine1 String
  /// @zod.string.trim().max(255)
  addressLine2 String?
  /// @zod.string.trim().min(1, { message: "City is required" }).max(100)
  city         String
  /// @zod.import(["import { UsState } from '@/lib/zod'"]).custom.use(UsState)
  state        String
  /// @zod.import(["import { UsPostalCode } from '@/lib/zod'"]).custom.use(UsPostalCode)
  postalCode   String
  /// @zod.import(["import { IsoCountry } from '@/lib/zod'"]).custom.use(IsoCountry)
  country      String         @default("US")
  /// @zod.import(["import { IanaTimezone } from '@/lib/zod'"]).custom.use(IanaTimezone)
  timezone     String         @default("America/New_York")
  /// @zod.import(["import { Latitude } from '@/lib/zod'"]).custom.use(Latitude)
  latitude     Float
  /// @zod.import(["import { Longitude } from '@/lib/zod'"]).custom.use(Longitude)
  longitude    Float
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@map("location")
}
