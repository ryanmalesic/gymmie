generator client {
  output   = "../lib/prisma/generated"
  provider = "prisma-client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../lib/prisma/generated/zod"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(dbgenerated("id()"))
  /// @zod.trim().min(1, "Name is required").max(80, "Name is too long")
  name          String
  /// @zod.trim().toLowerCase().min(1, { abort: true, error: "Email is required" }).regex(/^[^\s@]+@[^\s@]+\.[^\s@]+$/, "Email is invalid")
  email         String
  emailVerified Boolean
  /// @zod.trim().toLowerCase().regex(/^https:\/\/[^\s]+$/, "Image is invalid")
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([email])
  @@map("user")
}
