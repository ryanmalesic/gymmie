generator client {
  output   = "../lib/generated/prisma"
  provider = "prisma-client"
}

generator zod {
  provider                         = "zod-prisma-types"
  output                           = "../lib/generated/zod"
  prismaClientPath                 = "../prisma"
  useMultipleFiles                 = false
  createInputTypes                 = true
  createModelTypes                 = true
  createOptionalDefaultValuesTypes = true
  createRelationValuesTypes        = false
  createPartialTypes               = true
  useDefaultValidators             = true
  validateWhereUniqueInput         = true
  coerceDate                       = true
  writeNullishInModelTypes         = false
}

datasource db {
  provider = "postgresql"
}

/// @zod.import(["import { HttpsUrl } from '@/lib/zod'"])
model User {
  id            String   @id @default(dbgenerated("id()"))
  /// @zod.string.trim().min(1, { message: "Name is required" }).max(80, { message: "Name is too long" })
  name          String
  /// @zod.string.trim().toLowerCase().email({ message: "Email is invalid" })
  email         String
  emailVerified Boolean
  /// @zod.import(["import { HttpsUrl } from '@/lib/zod'"]).custom.use(HttpsUrl.nullish())
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("id()"))
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                   String    @id @default(dbgenerated("id()"))
  userId               String
  accountId            String
  providerId           String
  issuer               String
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("id()"))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
